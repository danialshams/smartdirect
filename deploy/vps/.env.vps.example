# VPS template only. Never store actual keys in Git.
NODE_ENV=production
EXECUTION_BACKEND=worker
DATABASE_URL=postgresql://USER:PASSWORD@DB_HOST:5432/DB_NAME
DIRECT_URL=postgresql://USER:PASSWORD@DB_HOST:5432/DB_NAME
NEXTAUTH_URL=https://your-domain.example
NEXTAUTH_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARS
CRON_SECRET=REPLACE_WITH_RANDOM_SECRET
INSTAGRAM_CLIENT_SECRET=REPLACE_WITH_YOUR_META_APP_SECRET
INSTAGRAM_CLIENT_ID=REPLACE_WITH_YOUR_META_APP_ID
REDIS_DRIVER=redis
# Docker Compose sets REDIS_URL internally.
STORAGE_PROVIDER=s3-compatible
S3_ENDPOINT=https://your-s3-compatible-provider.example
S3_REGION=us-east-1
S3_BUCKET=your-bucket
S3_ACCESS_KEY_ID=REPLACE_ME
S3_SECRET_ACCESS_KEY=REPLACE_ME
S3_PUBLIC_BASE_URL=https://media.your-domain.example
QUEUE_WORKER_CONCURRENCY=4
