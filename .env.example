# SmartDirect environment template
# Copy to .env.local for local development.
# Never commit real secrets.

NODE_ENV=development
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-a-long-random-secret
CRON_SECRET=replace-with-a-long-random-secret

DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# Redis provider. Current SmartDirect Redis layer uses Upstash REST.
REDIS_DRIVER=upstash
UPSTASH_REDIS_REST_URL=https://YOUR-ENDPOINT.upstash.io
UPSTASH_REDIS_REST_TOKEN=YOUR-REDIS-TOKEN
REDIS_COMMAND_TIMEOUT_MS=5000

QUEUE_WORKER_CONCURRENCY=2
QUEUE_WORKER_POLL_INTERVAL_MS=1000
QUEUE_RECOVERY_INTERVAL_MS=10000
QUEUE_PROMOTION_INTERVAL_MS=1000
QUEUE_STALLED_TTL_SECONDS=30
QUEUE_CLAIM_TTL_SECONDS=30

# Meta / Instagram
INSTAGRAM_WEBHOOK_VERIFY_TOKEN=replace-me
INSTAGRAM_APP_ID=replace-me
INSTAGRAM_APP_SECRET=replace-me
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000
