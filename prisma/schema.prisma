generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                                                             String                @id @default(cuid())
  email                                                          String                @unique
  name                                                           String
  password                                                       String
  role                                                           Role                  @default(USER)
  createdAt                                                      DateTime              @default(now())
  updatedAt                                                      DateTime              @updatedAt
  comments                                                       Comment[]
  conversations                                                  Conversation[]
  ConversationHandoff_ConversationHandoff_assignedToUserIdToUser ConversationHandoff[] @relation("ConversationHandoff_assignedToUserIdToUser")
  ConversationHandoff_ConversationHandoff_userIdToUser           ConversationHandoff[] @relation("ConversationHandoff_userIdToUser")
  forms                                                          Form[]
  instagramAccounts                                              InstagramAccount[]
  instagramPublishJobs                                           InstagramPublishJob[]
  showcases                                                      Showcase[]
}

model InstagramAccount {
  id                 String                     @id @default(cuid())
  userId             String
  igUserId           String                     @unique
  igUsername         String
  accessToken        String
  tokenExpiresAt     DateTime?
  isConnected        Boolean                    @default(false)
  createdAt          DateTime                   @default(now())
  updatedAt          DateTime                   @updatedAt
  automations        Automation[]
  conversations      Conversation[]
  forms              Form[]
  iceBreakers        IceBreaker[]
  user               User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  insightSnapshots   InstagramInsightSnapshot[]
  publishJobs        InstagramPublishJob[]
  pendingFollowGates PendingFollowGate[]
  persistentMenu     PersistentMenu?
  showcases          Showcase[]

  @@unique([userId, igUserId])
  @@index([userId])
}

model InstagramInsightSnapshot {
  id                 String           @id @default(cuid())
  instagramAccountId String
  snapshotDate       DateTime
  reach              Int?
  views              Int?
  accountsEngaged    Int?
  totalInteractions  Int?
  profileViews       Int?
  followerCount      Int?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  follows            Int?
  unfollows          Int?
  profileLinksTaps   Int?
  instagramAccount   InstagramAccount @relation(fields: [instagramAccountId], references: [id], onDelete: Cascade)

  @@unique([instagramAccountId, snapshotDate])
  @@index([instagramAccountId])
  @@index([instagramAccountId, snapshotDate])
}

model Automation {
  id                  String                @id @default(cuid())
  instagramAccountId  String
  keyword             String?
  replyText           String?
  isActive            Boolean               @default(true)
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  commentReplyText    String?
  likeComment         Boolean               @default(false)
  mediaId             String?
  likeIncomingDm      Boolean               @default(false)
  sendDm              Boolean               @default(false)
  triggerType         AutomationTriggerType @default(COMMENT_KEYWORD)
  likeStoryReply      Boolean               @default(false)
  followGateText      String?
  requireFollow       Boolean               @default(false)
  instagramAccount    InstagramAccount      @relation(fields: [instagramAccountId], references: [id], onDelete: Cascade)
  messages            AutomationMessage[]
  iceBreakers         IceBreaker[]
  pendingFollowGates  PendingFollowGate[]
  persistentMenuItems PersistentMenuItem[]

  @@unique([instagramAccountId, keyword, mediaId])
  @@index([instagramAccountId])
  @@index([mediaId])
  @@index([instagramAccountId, triggerType])
  @@index([instagramAccountId, keyword])
}

model AutomationMessage {
  id                   String                @id @default(cuid())
  automationId         String
  text                 String?
  order                Int
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  formId               String?
  mediaId              String?
  mediaUrl             String?
  messageType          AutomationMessageType @default(TEXT)
  showcaseId           String?
  automation           Automation            @relation(fields: [automationId], references: [id], onDelete: Cascade)
  form                 Form?                 @relation(fields: [formId], references: [id])
  showcase             Showcase?             @relation(fields: [showcaseId], references: [id])
  quickReplies         QuickReply[]
  nextFromQuickReplies QuickReply[]          @relation("QuickReplyNextMessage")

  @@index([automationId])
  @@index([automationId, order])
  @@index([showcaseId])
  @@index([formId])
}

model QuickReply {
  id                   String                @id @default(cuid())
  automationMessageId  String
  title                String
  payload              String
  replyText            String?
  nextMessageId        String?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  conversationMessages ConversationMessage[]
  automationMessage    AutomationMessage     @relation(fields: [automationMessageId], references: [id], onDelete: Cascade)
  nextMessage          AutomationMessage?    @relation("QuickReplyNextMessage", fields: [nextMessageId], references: [id])

  @@index([automationMessageId])
  @@index([nextMessageId])
  @@index([payload])
}

model IceBreaker {
  id                 String           @id @default(cuid())
  instagramAccountId String
  automationId       String
  question           String
  payload            String
  order              Int              @default(0)
  isActive           Boolean          @default(true)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  automation         Automation       @relation(fields: [automationId], references: [id], onDelete: Cascade)
  instagramAccount   InstagramAccount @relation(fields: [instagramAccountId], references: [id], onDelete: Cascade)

  @@unique([instagramAccountId, payload])
  @@index([instagramAccountId])
  @@index([automationId])
  @@index([instagramAccountId, order])
}

model PersistentMenu {
  id                 String               @id @default(cuid())
  instagramAccountId String               @unique
  enabled            Boolean              @default(true)
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  instagramAccount   InstagramAccount     @relation(fields: [instagramAccountId], references: [id], onDelete: Cascade)
  items              PersistentMenuItem[]
}

model PersistentMenuItem {
  id               String         @id @default(cuid())
  persistentMenuId String
  title            String
  payload          String
  automationId     String?
  order            Int            @default(0)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime
  automation       Automation?    @relation(fields: [automationId], references: [id])
  persistentMenu   PersistentMenu @relation(fields: [persistentMenuId], references: [id], onDelete: Cascade)

  @@index([persistentMenuId])
  @@index([automationId])
}

model Conversation {
  id                        String                @id @default(cuid())
  userId                    String
  instagramAccountId        String
  igUserId                  String
  participantId             String
  isActive                  Boolean               @default(true)
  lastMessageAt             DateTime?
  createdAt                 DateTime              @default(now())
  updatedAt                 DateTime              @updatedAt
  participantUsername       String?
  participantName           String?
  participantProfilePicture String?
  instagramAccount          InstagramAccount      @relation(fields: [instagramAccountId], references: [id], onDelete: Cascade)
  user                      User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  ConversationHandoff       ConversationHandoff?
  messages                  ConversationMessage[]

  @@unique([instagramAccountId, participantId])
  @@index([userId])
  @@index([instagramAccountId])
  @@index([instagramAccountId, lastMessageAt])
}

model ConversationMessage {
  id             String           @id @default(cuid())
  conversationId String
  direction      MessageDirection
  messageType    MessageType
  text           String?
  igMessageId    String?          @unique
  quickReplyId   String?
  createdAt      DateTime         @default(now())
  mediaId        String?
  mediaUrl       String?
  readAt         DateTime?
  seenAt         DateTime?
  conversation   Conversation     @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  quickReply     QuickReply?      @relation(fields: [quickReplyId], references: [id])

  @@index([conversationId, createdAt])
  @@index([conversationId, readAt])
  @@index([quickReplyId])
}

model Comment {
  id          String   @id @default(cuid())
  userId      String
  igMediaId   String
  igCommentId String   @unique
  text        String
  username    String
  replied     Boolean  @default(false)
  replyText   String?
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, igMediaId])
}

model Showcase {
  id                 String              @id @default(cuid())
  userId             String
  instagramAccountId String
  title              String
  description        String?
  isActive           Boolean             @default(true)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  messages           AutomationMessage[]
  instagramAccount   InstagramAccount    @relation(fields: [instagramAccountId], references: [id], onDelete: Cascade)
  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  items              ShowcaseItem[]

  @@index([userId])
  @@index([instagramAccountId])
}

model ShowcaseItem {
  id            String   @id @default(cuid())
  showcaseId    String
  title         String
  description   String?
  imageUrl      String?
  price         Decimal?
  originalPrice Decimal?
  linkUrl       String?
  buttonText    String?
  order         Int      @default(0)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  showcase      Showcase @relation(fields: [showcaseId], references: [id], onDelete: Cascade)

  @@index([showcaseId])
  @@index([showcaseId, order])
}

model Form {
  id                 String              @id @default(cuid())
  userId             String
  instagramAccountId String
  title              String
  description        String?
  isActive           Boolean             @default(true)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  messages           AutomationMessage[]
  instagramAccount   InstagramAccount    @relation(fields: [instagramAccountId], references: [id], onDelete: Cascade)
  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  fields             FormField[]
  submissions        FormSubmission[]

  @@index([userId])
  @@index([instagramAccountId])
}

model FormField {
  id          String        @id @default(cuid())
  formId      String
  label       String
  name        String
  type        FormFieldType
  required    Boolean       @default(false)
  placeholder String?
  options     Json?
  order       Int           @default(0)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  form        Form          @relation(fields: [formId], references: [id], onDelete: Cascade)

  @@index([formId])
  @@index([formId, order])
}

model FormSubmission {
  id        String   @id @default(cuid())
  formId    String
  igUserId  String?
  username  String?
  answers   Json
  createdAt DateTime @default(now())
  form      Form     @relation(fields: [formId], references: [id], onDelete: Cascade)

  @@index([formId])
  @@index([igUserId])
}

model PendingFollowGate {
  id                 String           @id @default(cuid())
  instagramAccountId String
  automationId       String
  participantId      String
  status             FollowGateStatus @default(PENDING)
  attempts           Int              @default(0)
  expiresAt          DateTime
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  automation         Automation       @relation(fields: [automationId], references: [id], onDelete: Cascade)
  instagramAccount   InstagramAccount @relation(fields: [instagramAccountId], references: [id], onDelete: Cascade)

  @@index([instagramAccountId, participantId, status])
  @@index([automationId])
  @@index([expiresAt])
}

model InstagramPublishJob {
  id                        String                  @id @default(cuid())
  userId                    String
  instagramAccountId        String
  type                      InstagramPublishType
  status                    InstagramPublishStatus  @default(DRAFT)
  caption                   String?
  scheduledAt               DateTime?
  publishedAt               DateTime?
  instagramContainerId      String?
  instagramMediaId          String?
  errorMessage              String?
  idempotencyKey            String?                 @unique
  retryCount                Int                     @default(0)
  lastAttemptAt             DateTime?
  createdAt                 DateTime                @default(now())
  updatedAt                 DateTime                @updatedAt
  userTags                  Json?
  commentAutomationId       String?
  storyReplyAutomationId    String?
  commentTriggerKeywords    String?
  commentTriggerResponse    String?
  storyReplyTriggerKeywords String?
  storyReplyTriggerResponse String?
  instagramAccount          InstagramAccount        @relation(fields: [instagramAccountId], references: [id], onDelete: Cascade)
  user                      User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  media                     InstagramPublishMedia[]

  @@unique([instagramAccountId, scheduledAt])
  @@index([userId])
  @@index([instagramAccountId])
  @@index([status])
  @@index([scheduledAt])
  @@index([instagramAccountId, status])
  @@index([status, scheduledAt])
  @@index([commentAutomationId])
  @@index([storyReplyAutomationId])
}

model QueueFailure {
  id                    String             @id @default(cuid())
  jobId                 String             @unique
  requeuedJobId         String?            @unique
  type                  String
  payload               Json
  priority              String
  attempts              Int
  maxAttempts           Int
  lastError             String
  tenantId              String?
  idempotencyKey        String?
  idempotencyTenantId   String?
  idempotencyOperation  String?
  idempotencyResourceId String?
  status                QueueFailureStatus @default(FAILED)
  failedAt              DateTime           @default(now())
  requeuedAt            DateTime?
  resolvedAt            DateTime?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  @@index([status, failedAt])
  @@index([tenantId, status])
  @@index([type, status])
}

model IdempotencyRecord {
  id           String            @id @default(cuid())
  key          String            @unique
  tenantId     String
  operation    String
  resourceId   String?
  status       IdempotencyStatus @default(IN_PROGRESS)
  response     Json?
  errorMessage String?
  expiresAt    DateTime
  completedAt  DateTime?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@index([tenantId, operation])
  @@index([tenantId, operation, status])
  @@index([expiresAt])
}

model InstagramPublishMedia {
  id           String              @id @default(cuid())
  publishJobId String
  type         InstagramMediaType
  storageKey   String
  publicUrl    String?
  fileName     String?
  mimeType     String?
  fileSize     Int?
  sortOrder    Int                 @default(0)
  deletedAt    DateTime?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  publishJob   InstagramPublishJob @relation(fields: [publishJobId], references: [id], onDelete: Cascade)

  @@index([publishJobId])
  @@index([publishJobId, sortOrder])
}

model ConversationHandoff {
  conversationId                                  String       @id
  userId                                          String
  active                                          Boolean      @default(true)
  assignedToUserId                                String?
  handedOffAt                                     DateTime     @default(now())
  handedBackAt                                    DateTime?
  User_ConversationHandoff_assignedToUserIdToUser User?        @relation("ConversationHandoff_assignedToUserIdToUser", fields: [assignedToUserId], references: [id])
  Conversation                                    Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  User_ConversationHandoff_userIdToUser           User         @relation("ConversationHandoff_userIdToUser", fields: [userId], references: [id], onDelete: Cascade)

  @@index([active])
  @@index([userId, active])
}

enum QueueFailureStatus {
  FAILED
  REQUEUED
  RESOLVED
}

enum IdempotencyStatus {
  IN_PROGRESS
  COMPLETED
  FAILED
}

enum FollowGateStatus {
  PENDING
  COMPLETED
  EXPIRED
}

enum AutomationTriggerType {
  COMMENT_KEYWORD
  DM
  STORY_REPLY_KEYWORD
}

enum AutomationMessageType {
  TEXT
  IMAGE
  VIDEO
  AUDIO
  SHOWCASE
  FORM
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum MessageType {
  TEXT
  QUICK_REPLY
  IMAGE
  VIDEO
  AUDIO
  STICKER
  REACTION
}

enum FormFieldType {
  TEXT
  TEXTAREA
  PHONE
  EMAIL
  NUMBER
  SELECT
  RADIO
  CHECKBOX
}

enum Role {
  USER
  ADMIN
}

enum InstagramPublishType {
  POST
  CAROUSEL
  REEL
  STORY
}

enum InstagramPublishStatus {
  DRAFT
  UPLOADING
  SCHEDULED
  PROCESSING
  PUBLISHING
  PUBLISHED
  FAILED
  CANCELLED
}

enum InstagramMediaType {
  IMAGE
  VIDEO
}
