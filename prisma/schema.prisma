generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                String             @id @default(cuid())
  email             String             @unique
  name              String
  password          String
  role              Role               @default(USER)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  instagramAccounts InstagramAccount[]
  comments          Comment[]
}

model InstagramAccount {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  igUserId       String   @unique
  igUsername     String
  accessToken    String
  tokenExpiresAt DateTime?
  isConnected    Boolean  @default(false)

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  automations    Automation[]

  @@unique([userId, igUserId])
}

model Automation {
  id                String           @id @default(cuid())

  instagramAccountId String
  instagramAccount InstagramAccount @relation(fields: [instagramAccountId], references: [id], onDelete: Cascade)

  keyword           String
  replyText         String
  isActive          Boolean          @default(true)

  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@index([instagramAccountId])
  @@index([instagramAccountId, keyword])
}

model Comment {
  id          String   @id @default(cuid())

  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  igMediaId   String
  igCommentId String   @unique

  text        String
  username    String

  replied     Boolean  @default(false)
  replyText   String?

  createdAt   DateTime @default(now())

  @@index([userId, igMediaId])
}

enum Role {
  USER
  ADMIN
}